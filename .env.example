# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_migrate
APP_ENV=dev
DEBUG=true

# AI — OpenRouter (cloud primary)
OPENROUTER_API_KEY=

# AI — Ollama (local fallback, used when OPENROUTER_API_KEY is empty)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Auth (Logto — leave LOGTO_ISSUER empty to disable JWT validation in dev)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGTO_ISSUER=
LOGTO_AUDIENCE=dclaw-migrate

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8121
